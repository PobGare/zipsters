<section class="social-section section-space"><div class="section-heading"><div><span class="eyebrow">OUT IN THE WORLD</span><h2>{{ section.settings.heading }}</h2></div><a class="text-link" href="{{ settings.instagram_url }}" target="_blank" rel="noopener">@ZIPSTERSOFFICIAL <span>↗</span></a></div><div class="social-grid">{% for block in section.blocks %}<a href="{{ block.settings.link | default: settings.instagram_url }}" target="_blank" rel="noopener" aria-label="View Zipsters photograph on Instagram" {{ block.shopify_attributes }}>{% render 'image', image: block.settings.image, fallback: block.settings.fallback, alt: block.settings.alt, sizes: '(max-width: 767px) 43vw, 20vw' %}<span>↗</span></a>{% endfor %}</div></section>
{% schema %}
{"name":"Instagram editorial","settings":[{"type":"text","id":"heading","label":"Heading","default":"Worn your way."}],"max_blocks":6,"blocks":[{"type":"photo","name":"Instagram photograph","settings":[{"type":"image_picker","id":"image","label":"Photograph"},{"type":"text","id":"fallback","label":"Bundled photo filename"},{"type":"text","id":"alt","label":"Image description"},{"type":"url","id":"link","label":"Instagram post"}]}],"presets":[{"name":"Instagram editorial"}]}
{% endschema %}
