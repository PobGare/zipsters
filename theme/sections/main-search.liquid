<section class="page-main"><div class="collection-intro"><h1>Search</h1><p>Results for “{{ search.terms | escape }}”</p></div><div class="collection-products">{% paginate search.results by 24 %}<div class="product-grid">{% for product in search.results %}{% if product.object_type == 'product' %}{% render 'product-card', product: product %}{% endif %}{% else %}<p class="empty-results">No pieces found. Try “Henley”.</p>{% endfor %}</div>{% if paginate.pages > 1 %}{{ paginate | default_pagination }}{% endif %}{% endpaginate %}</div></section>
{% schema %}{"name":"Search","settings":[]}{% endschema %}
