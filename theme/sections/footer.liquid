<footer class="site-footer"><div class="newsletter"><div><span class="eyebrow">THE OCCASIONAL GOOD THING</span><h2>{{ section.settings.heading }}</h2><p>New collections, restocks and everything Zipsters.</p></div>
{% form 'customer', id: 'newsletter-form', class: 'newsletter-form' %}<input type="hidden" name="contact[tags]" value="newsletter"><div class="newsletter-field"><label class="visually-hidden" for="newsletter-email">Email address</label><input type="email" id="newsletter-email" name="contact[email]" placeholder="Your email address" autocomplete="email" required><button type="submit">JOIN <span>↗</span></button></div>{% if form.posted_successfully? %}<p role="status">You’re on the list.</p>{% endif %}{{ form.errors | default_errors }}<p class="form-message" data-newsletter-status role="status"></p>{% endform %}</div>
<div class="footer-main"><div class="footer-about"><span class="footer-brand">ZIPSTERS</span><span class="eyebrow">EVERYDAY. IN CHARACTER.</span><p>Menswear with a point of view.<br>The Henley at its heart.</p><a href="{{ settings.instagram_url }}" target="_blank" rel="noopener">@zipstersofficial ↗</a></div><div><h3>SHOP</h3><a href="{{ routes.collections_url }}/henleys">Henleys</a><a href="{{ routes.collections_url }}/t-shirts">T-shirts & mesh</a><a href="{{ routes.collections_url }}/pants">Pants & denim</a><a href="{{ routes.all_products_collection_url }}">The collection</a></div><div><h3>ABOUT</h3><a href="{{ routes.root_url }}#story">The Henley story</a><a href="{{ routes.root_url }}#lookbook">The Edit</a><a href="{{ settings.instagram_url }}">Instagram</a></div><div><h3>SOCIAL & HELP</h3><a href="{{ settings.instagram_url }}">Contact Zipsters ↗</a>{% for link in section.settings.help_menu.links %}<a href="{{ link.url }}">{{ link.title }}</a>{% endfor %}{% if shop.customer_accounts_enabled %}<a href="{{ routes.account_url }}">My account</a>{% endif %}</div></div>
<div class="footer-bottom"><span>© {{ 'now' | date: '%Y' }} ZIPSTERS</span><div>{% for policy in shop.policies %}{% if policy.body != blank %}<a href="{{ policy.url }}">{{ policy.title }}</a>{% endif %}{% endfor %}</div><span>{% if localization.country != blank %}{{ localization.country.name }} / {{ localization.country.currency.iso_code }}{% else %}ZIPSTERS / EST. 2018{% endif %}</span></div></footer>
{% schema %}
{"name":"Footer and newsletter","settings":[{"type":"text","id":"heading","label":"Newsletter heading","default":"Stay in the loop."},{"type":"link_list","id":"help_menu","label":"Help and policy links"}]}
{% endschema %}
