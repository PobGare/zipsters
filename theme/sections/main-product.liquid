<section class="pdp"><div class="pdp-gallery" aria-label="Product photographs">{% for image in product.images %}{% if forloop.first %}{% assign loading = 'eager' %}{% else %}{% assign loading = 'lazy' %}{% endif %}{% render 'image', image: image, alt: product.title, loading: loading, sizes: '(max-width: 767px) 90vw, 60vw' %}{% endfor %}</div>
<div class="pdp-panel"><a class="breadcrumb" href="{{ routes.root_url }}collections/henleys">ZIPSTERS / {{ product.type | upcase }}</a><h1>{{ product.title }}</h1>{% if product.price != blank %}<div class="pdp-price">{{ product.selected_or_first_available_variant.price | money }}</div>{% endif %}<p class="pdp-color">{{ product.metafields.custom.color.value }}</p>
{% if product.variants.size > 0 %}{% form 'product', product, class: 'product-form', data-product-form: '' %}<label for="variant-{{ section.id }}">{{ 'products.choose_variant' | t }}</label><select name="id" id="variant-{{ section.id }}" required>{% for variant in product.variants %}<option value="{{ variant.id }}" {% unless variant.available %}disabled{% endunless %} {% if variant == product.selected_or_first_available_variant %}selected{% endif %}>{{ variant.title }} — {{ variant.price | money }}{% unless variant.available %} — {{ 'products.unavailable' | t }}{% endunless %}</option>{% endfor %}</select><button class="button" type="submit" {% unless product.available %}disabled{% endunless %}>{% if product.available %}{{ 'products.add_to_bag' | t }}{% else %}{{ 'products.unavailable' | t }}{% endif %} <span>↗</span></button><p data-product-error role="alert"></p>{% endform %}
{% else %}<p>Explore the piece with Zipsters.</p><a class="button" href="{{ settings.instagram_url }}" target="_blank" rel="noopener">ENQUIRE WITH ZIPSTERS <span>↗</span></a>{% endif %}
{% if product.description != blank %}<details open><summary>DESCRIPTION</summary><div>{{ product.description }}</div></details>{% endif %}
{% if product.metafields.custom.fit != blank %}<details><summary>FIT</summary><div>{{ product.metafields.custom.fit | metafield_tag }}</div></details>{% endif %}
{% if product.metafields.custom.fabric != blank %}<details><summary>FABRIC / MATERIAL</summary><div>{{ product.metafields.custom.fabric | metafield_tag }}</div></details>{% endif %}
{% if product.metafields.custom.care != blank %}<details><summary>CARE</summary><div>{{ product.metafields.custom.care | metafield_tag }}</div></details>{% endif %}
{% if section.settings.size_guide != blank %}<details><summary>SIZE GUIDE</summary><div>{{ section.settings.size_guide.content }}</div></details>{% endif %}
{% if shop.shipping_policy.body != blank or shop.refund_policy.body != blank %}<details><summary>SHIPPING / RETURNS</summary><div>{{ shop.shipping_policy.body }}{{ shop.refund_policy.body }}</div></details>{% endif %}</div></section>
{% schema %}{"name":"Product","settings":[{"type":"page","id":"size_guide","label":"Size guide page"}]}{% endschema %}
