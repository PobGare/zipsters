<section class="editorial-story" id="story"><div class="story-main">{% render 'image', image: section.settings.image, fallback: 'henley-brown-alt', alt: 'Brown Zipsters Henley styled with denim in a green café', sizes: '(max-width: 767px) 100vw, 58vw' %}<span class="image-caption">ZIPSTERS / EVERYDAY STUDIES</span></div>
<div class="story-side"><span class="eyebrow">{{ section.settings.eyebrow }}</span><h2>{{ section.settings.heading | newline_to_br }}</h2><p>{{ section.settings.copy }}</p><a class="text-link" href="{{ section.settings.link }}">DISCOVER THE HENLEY <span>↗</span></a><div class="story-detail">{% render 'image', image: section.settings.detail, fallback: 'henley-white', alt: 'Close-up of the white Henley’s texture and button placket', sizes: '(max-width: 767px) 45vw, 20vw' %}<span>Texture. Shape. Character.</span></div></div></section>
{% schema %}
{"name":"Henley editorial story","settings":[{"type":"image_picker","id":"image","label":"Main photograph"},{"type":"image_picker","id":"detail","label":"Detail photograph"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"A FAMILIAR FEELING"},{"type":"textarea","id":"heading","label":"Heading","default":"The everyday\nuniform."},{"type":"textarea","id":"copy","label":"Copy","default":"Some pieces just feel like you. Worn with denim, paired with pleats, or taken out for a slow afternoon. This is the Henley, your way."},{"type":"url","id":"link","label":"Link","default":"/collections/henleys"}],"presets":[{"name":"Henley editorial story"}]}
{% endschema %}
