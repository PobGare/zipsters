<section class="page-main"><div class="page-content"><h1>Your bag</h1>{% if cart.item_count > 0 %}<form action="{{ routes.cart_url }}" method="post">{% for item in cart.items %}<div class="cart-line">{{ item.image | image_url: width: 200 | image_tag: alt: item.title, loading: 'lazy' }}<div><h3>{{ item.product.title }}</h3><p>{{ item.variant.title }}</p><label>Quantity <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="Quantity for {{ item.product.title | escape }}"></label><p>{{ item.final_line_price | money }}</p></div></div>{% endfor %}<p>Subtotal: {{ cart.total_price | money }}</p><button class="button" name="update">UPDATE BAG</button> <button class="button" name="checkout">CHECKOUT ↗</button></form>{% else %}<p>Your bag is empty.</p><a class="text-link" href="{{ routes.root_url }}collections/henleys">SHOP HENLEYS ↗</a>{% endif %}</div></section>
{% schema %}{"name":"Cart","settings":[]}{% endschema %}
