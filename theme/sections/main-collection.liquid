{% liquid
 assign hero_photo = collection.image | default: section.settings.image
%}
<section class="page-main" data-collection-section="{{ section.id }}"><div class="collection-heading"><h1>{{ collection.title }}</h1></div>
{% if section.settings.show_image and hero_photo != blank %}<div class="collection-banner">{% render 'image', image: hero_photo, alt: collection.title, sizes: '100vw' %}</div>{% endif %}
<nav class="collection-navigation" aria-label="Shop collections"><a href="{{ routes.root_url }}collections/all" {% if collection.handle == 'all' %}aria-current="page"{% endif %}>All</a><a href="{{ routes.root_url }}collections/henleys" {% if collection.handle == 'henleys' %}aria-current="page"{% endif %}>Henleys</a><a href="{{ routes.root_url }}collections/t-shirts" {% if collection.handle == 't-shirts' %}aria-current="page"{% endif %}>T-shirts & mesh</a><a href="{{ routes.root_url }}collections/pants" {% if collection.handle == 'pants' %}aria-current="page"{% endif %}>Pants & denim</a></nav><div class="collection-products" id="collection-products"><div class="collection-toolbar"><span>{{ collection.products_count }} {% if collection.products_count == 1 %}piece{% else %}pieces{% endif %}</span><div class="collection-controls"><button data-open="filter-drawer">Filter +</button><label class="visually-hidden" for="sort">Sort products</label><select data-sort id="sort" name="sort_by">{% for option in collection.sort_options %}<option value="{{ option.value }}" {% if option.value == collection.sort_by %}selected{% endif %}>{{ option.name }}</option>{% endfor %}</select></div></div>
{% paginate collection.products by 24 %}<div class="product-grid">{% for product in collection.products %}{% render 'product-card', product: product %}{% else %}<p class="empty-results">No pieces match this selection.</p>{% endfor %}</div>{% if paginate.pages > 1 %}{{ paginate | default_pagination }}{% endif %}{% endpaginate %}</div></section>
<dialog id="filter-drawer" class="drawer" aria-labelledby="filter-title"><div class="drawer-top"><h2 id="filter-title">Filters</h2><button class="icon-button" data-close aria-label="Close filters">{% render 'icon', name: 'close' %}</button></div><form data-collection-filters class="filter-panel" action="{{ collection.url }}"><input type="hidden" name="sort_by" value="{{ collection.sort_by }}">{% for filter in collection.filters %}<fieldset><legend>{{ filter.label }}</legend>{% if filter.type == 'price_range' %}<label>From <input name="{{ filter.min_value.param_name }}" type="number" min="0" value="{{ filter.min_value.value | divided_by: 100.0 }}"></label><label>To <input name="{{ filter.max_value.param_name }}" type="number" min="0" value="{{ filter.max_value.value | divided_by: 100.0 }}"></label>{% else %}{% for value in filter.values %}<label><input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %}>{{ value.label }} ({{ value.count }})</label>{% endfor %}{% endif %}</fieldset>{% endfor %}<button type="submit" class="button" data-close>APPLY FILTERS <span>↗</span></button><p style="margin-top:20px"><a class="text-link" data-filter-clear href="{{ collection.url }}">CLEAR ALL</a></p></form></dialog>
<p class="collection-status" data-collection-status role="status" aria-live="polite"></p>
<script src="{{ 'collection-filters.js' | asset_url }}" defer></script>
{% schema %}{"name":"Collection","settings":[{"type":"checkbox","id":"show_image","label":"Show collection campaign image","default":false},{"type":"image_picker","id":"image","label":"Collection campaign fallback"}]}{% endschema %}
