{% liquid
 assign hero_photo = collection.image | default: section.settings.image
 assign hero_fallback = 'henley-white-alt'
 case collection.handle
 when 'henleys'
 assign hero_fallback = 'henley-white'
 when 't-shirts'
 assign hero_fallback = 'denim-styled'
 when 'pants'
 assign hero_fallback = 'denim'
 endcase
%}
<section class="page-main"><div class="collection-hero collection-hero--{{ collection.handle }}"><div class="collection-intro"><span class="eyebrow">THE ZIPSTERS WARDROBE</span><h1>{{ collection.title }}</h1>{{ collection.description }}<a class="text-link" href="#collection-products">EXPLORE THE PIECES <span>↓</span></a></div><div class="collection-hero-image">{% render 'image', image: hero_photo, fallback: hero_fallback, alt: collection.title, sizes: '(max-width: 767px) 100vw, 53vw', loading: 'eager' %}<span class="collection-hero-note">ZIPSTERS / IN CHARACTER</span></div></div><div class="collection-products" id="collection-products"><div class="collection-toolbar"><span>{{ collection.products_count }} {% if collection.products_count == 1 %}piece{% else %}pieces{% endif %}</span><div class="collection-controls"><button data-open="filter-drawer">Filter +</button><label class="visually-hidden" for="sort">Sort products</label><select data-sort id="sort" name="sort_by">{% for option in collection.sort_options %}<option value="{{ option.value }}" {% if option.value == collection.sort_by %}selected{% endif %}>{{ option.name }}</option>{% endfor %}</select></div></div>
{% paginate collection.products by 24 %}<div class="product-grid">{% for product in collection.products %}{% render 'product-card', product: product %}{% else %}<p class="empty-results">No pieces match this selection.</p>{% endfor %}</div>{% if paginate.pages > 1 %}{{ paginate | default_pagination }}{% endif %}{% endpaginate %}</div></section>
<dialog id="filter-drawer" class="drawer" aria-labelledby="filter-title"><div class="drawer-top"><h2 id="filter-title">Refine your edit</h2><button class="icon-button" data-close aria-label="Close filters">{% render 'icon', name: 'close' %}</button></div><form class="filter-panel" action="{{ collection.url }}"><input type="hidden" name="sort_by" value="{{ collection.sort_by }}">{% for filter in collection.filters %}<fieldset><legend>{{ filter.label }}</legend>{% if filter.type == 'price_range' %}<label>From <input name="{{ filter.min_value.param_name }}" type="number" min="0" value="{{ filter.min_value.value | divided_by: 100.0 }}"></label><label>To <input name="{{ filter.max_value.param_name }}" type="number" min="0" value="{{ filter.max_value.value | divided_by: 100.0 }}"></label>{% else %}{% for value in filter.values %}<label><input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %}>{{ value.label }} ({{ value.count }})</label>{% endfor %}{% endif %}</fieldset>{% endfor %}<button type="submit" class="button">APPLY FILTERS <span>↗</span></button><p style="margin-top:20px"><a class="text-link" href="{{ collection.url }}">CLEAR ALL</a></p></form></dialog>
{% schema %}{"name":"Collection","settings":[{"type":"image_picker","id":"image","label":"Collection campaign fallback"}]}{% endschema %}
