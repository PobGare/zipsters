<section class="campaign"><div class="campaign-image"><picture class="campaign-desktop">{% render 'image', image: section.settings.image, fallback: 'campaign-cafe', alt: 'A black Zipsters Henley worn at a café', sizes: '100vw' %}</picture><div class="campaign-mobile">{% render 'image', image: section.settings.mobile_image, fallback: 'campaign-garden', alt: 'White Zipsters Henley, worn outdoors among palms', sizes: '(max-width: 767px) 58vw, 1px' %}</div></div><div class="campaign-shade"></div><div class="campaign-copy"><span class="eyebrow">{{ section.settings.eyebrow }}</span><h2><span class="campaign-heading-desktop">{{ section.settings.heading | newline_to_br }}</span><span class="campaign-heading-mobile">{{ section.settings.mobile_heading | default: "Off the clock." }}</span></h2><a class="text-link" href="{{ section.settings.link }}">{{ section.settings.label }} <span>↗</span></a></div><span class="campaign-note">DRESSED FOR THE UNPLANNED.</span></section>
{% schema %}
{"name":"Full-bleed campaign","settings":[{"type":"image_picker","id":"image","label":"Desktop photograph"},{"type":"image_picker","id":"mobile_image","label":"Mobile photograph"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"OFF THE CLOCK"},{"type":"textarea","id":"heading","label":"Heading","default":"Nothing on the agenda.\nEverything in its place."},{"type":"text","id":"mobile_heading","label":"Mobile heading","default":"Off the clock."},{"type":"text","id":"label","label":"Link label","default":"EXPLORE THE COLLECTION"},{"type":"url","id":"link","label":"Link","default":"/collections/all"}],"presets":[{"name":"Full-bleed campaign"}]}
{% endschema %}
