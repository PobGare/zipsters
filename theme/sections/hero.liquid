<section class="hero" aria-labelledby="hero-title" style="--desktop-position: {{ section.settings.desktop_position }}%; --mobile-position: {{ section.settings.mobile_position }}%">
  <picture class="hero-desktop">{% if section.settings.mobile_image != blank %}<source media="(max-width: 767px)" srcset="{{ section.settings.mobile_image | image_url: width: 480 }} 480w, {{ section.settings.mobile_image | image_url: width: 750 }} 750w, {{ section.settings.mobile_image | image_url: width: 960 }} 960w, {{ section.settings.mobile_image | image_url: width: 1200 }} 1200w" sizes="100vw">{% endif %}{% render 'image', image: section.settings.image, fallback: 'hero-cafe', alt: 'The white Zipsters long-sleeve Henley, worn at a café', loading: 'eager' %}</picture>
  <div class="hero-shade"></div>
  <div class="hero-copy"><p class="eyebrow">{{ section.settings.eyebrow }}</p><h1 id="hero-title">{{ section.settings.heading | newline_to_br }}</h1><p class="hero-description">{{ section.settings.copy }}</p><a class="button button-light" href="{{ section.settings.link }}">{{ section.settings.label }} <span>↗</span></a></div>
  <div class="hero-bottom"><span>THE ZIPSTERS WAY</span><a href="#signature">Explore the everyday <span>↓</span></a><span>01 / THE HENLEY</span></div>
</section>
{% schema %}
{"name":"Henley campaign hero","settings":[{"type":"image_picker","id":"image","label":"Desktop photograph"},{"type":"image_picker","id":"mobile_image","label":"Mobile photograph"},{"type":"range","id":"desktop_position","label":"Desktop vertical focal point","min":0,"max":100,"step":1,"default":37},{"type":"range","id":"mobile_position","label":"Mobile vertical focal point","min":0,"max":100,"step":1,"default":48},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"THE SIGNATURE COLLECTION"},{"type":"textarea","id":"heading","label":"Heading","default":"The Henley.\nAlways in character."},{"type":"text","id":"copy","label":"Supporting copy","default":"An everyday essential. A distinctly Zipsters point of view."},{"type":"text","id":"label","label":"Button label","default":"SHOP HENLEYS"},{"type":"url","id":"link","label":"Button link","default":"/collections/henleys"}],"presets":[{"name":"Henley campaign hero"}]}
{% endschema %}
