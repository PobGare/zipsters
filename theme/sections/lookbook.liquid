<section class="lookbook section-space" id="lookbook"><div class="section-heading"><div><span class="eyebrow">THE ZIPSTERS EDIT</span><h2>{{ section.settings.heading }}</h2></div><p class="lookbook-intro">{{ section.settings.copy }}</p></div>
<div class="lookbook-grid">{% for block in section.blocks %}<figure class="lookbook-item lookbook-item-{{ forloop.index }}" {{ block.shopify_attributes }}><a href="{% if block.settings.product != blank %}{{ block.settings.product.url }}{% else %}{{ block.settings.link }}{% endif %}">{% render 'image', image: block.settings.image, fallback: block.settings.fallback, alt: block.settings.caption, sizes: '(max-width: 767px) 90vw, 50vw' %}<span class="lookbook-number">LOOK 0{{ forloop.index }}</span><span class="lookbook-open" aria-hidden="true">↗</span></a><figcaption><span>{{ block.settings.caption }}</span><span>{{ block.settings.note }}</span></figcaption></figure>{% endfor %}
<div class="lookbook-note"><span class="eyebrow">THREE WAYS TO WEAR IT.</span><p>One signature.<br><em>Your way.</em></p></div><a class="text-link lookbook-cta" href="{{ routes.all_products_collection_url }}">FIND YOUR LOOK <span>↗</span></a></div></section>
{% schema %}
{"name":"Editorial lookbook","settings":[{"type":"text","id":"heading","label":"Heading","default":"A way of wearing it."},{"type":"text","id":"copy","label":"Copy","default":"From the first coffee to the last light. A few ways to make it yours."}],"max_blocks":3,"blocks":[{"type":"look","name":"Look","settings":[{"type":"image_picker","id":"image","label":"Photograph"},{"type":"text","id":"fallback","label":"Bundled photo filename"},{"type":"text","id":"caption","label":"Caption"},{"type":"text","id":"note","label":"Small note"},{"type":"product","id":"product","label":"Featured product"},{"type":"url","id":"link","label":"Fallback link"}]}],"presets":[{"name":"Editorial lookbook"}]}
{% endschema %}
