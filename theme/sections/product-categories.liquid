<section class="category-section" aria-label="Product categories"><div class="category-grid">
  {% for block in section.blocks %}
    {% liquid
      assign category = block.settings.collection
      assign label = block.settings.label | default: category.title
      assign link = category.url | default: block.settings.link
      assign photo = block.settings.image | default: category.image
    %}
    <a class="category-tile" href="{{ link }}" {{ block.shopify_attributes }}><div class="category-photo" style="--category-position:{{ block.settings.position }}%">{% render 'image', image: photo, fallback: block.settings.fallback, alt: label, sizes: '(max-width: 767px) 50vw, 25vw' %}</div><span>{{ label | escape }}</span></a>
  {% endfor %}
</div></section>
{% schema %}
{"name":"Product categories","max_blocks":6,"settings":[],"blocks":[{"type":"category","name":"Category","settings":[{"type":"collection","id":"collection","label":"Collection"},{"type":"text","id":"label","label":"Label"},{"type":"url","id":"link","label":"Fallback collection link"},{"type":"image_picker","id":"image","label":"Photograph"},{"type":"text","id":"fallback","label":"Bundled photo filename"},{"type":"range","id":"position","label":"Vertical crop","min":0,"max":100,"step":1,"default":50,"unit":"%"}]}],"presets":[{"name":"Product categories"}]}
{% endschema %}
