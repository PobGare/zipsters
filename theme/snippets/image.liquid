{% liquid
  assign loading = loading | default: 'lazy'
  assign sizes = sizes | default: '100vw'
  assign class = class | default: ''
  assign priority = 'auto'
  if loading == 'eager'
    assign priority = 'high'
  endif
%}
{% if image != blank %}
  {{ image | image_url: width: 2400 | image_tag: widths: '480, 750, 960, 1280, 1600, 2000, 2400', sizes: sizes, loading: loading, fetchpriority: priority, class: class, alt: alt }}
{% elsif fallback != blank %}
  <img class="{{ class }}" src="{{ fallback | append: '-960.jpg' | asset_url }}" srcset="{{ fallback | append: '-480.jpg' | asset_url }} 480w, {{ fallback | append: '-960.jpg' | asset_url }} 960w, {{ fallback | append: '-1200.jpg' | asset_url }} 1200w{% if fallback == 'hero-cafe' %}, {{ fallback | append: '-2400.jpg' | asset_url }} 2400w{% endif %}" sizes="{{ sizes }}" decoding="async" width="1200" height="1600" alt="{{ alt | escape }}" loading="{{ loading }}" {% if loading == 'eager' %}fetchpriority="high"{% endif %}>
{% endif %}
