<header class="site-header {% unless template.name == 'index' %}is-solid{% endunless %}" data-header>
  <div class="header-inner">
    <nav class="desktop-nav" aria-label="Main navigation">
      <a class="nav-link" href="{{ routes.root_url }}collections/henleys">Henleys</a>
      <button class="nav-link" data-open="mobile-menu" aria-haspopup="dialog" aria-controls="mobile-menu">Shop</button>
      <a class="nav-link" href="{{ routes.root_url }}#lookbook">Get the Look</a>
    </nav>
    <button class="icon-button mobile-menu-button" aria-label="Open menu" data-open="mobile-menu">{% render 'icon', name: 'menu' %}</button>
    <a class="wordmark" href="{{ routes.root_url }}" aria-label="Zipsters home">{% if section.settings.logo != blank %}{{ section.settings.logo | image_url: width: 400 | image_tag: width: 180, alt: shop.name }}{% else %}ZIPSTERS{% endif %}</a>
    <div class="header-actions">
      <button class="icon-button search-trigger" aria-label="Search" data-open="search-dialog">{% render 'icon', name: 'search' %}</button>
      {% if shop.customer_accounts_enabled %}<a class="icon-button account-link" href="{{ routes.account_url }}" aria-label="Account">{% render 'icon', name: 'account' %}</a>{% endif %}
      <button class="bag-button" aria-label="Open shopping bag" data-open="cart-drawer">{% render 'icon', name: 'bag' %}<span class="bag-label">Bag</span> <span data-cart-count>({{ cart.item_count | default: 0 }})</span></button>
    </div>
  </div>
</header>
<dialog id="mobile-menu" class="drawer menu-drawer" aria-label="Navigation">
  <div class="drawer-top"><span class="wordmark">ZIPSTERS</span><button class="icon-button" data-close aria-label="Close menu">{% render 'icon', name: 'close' %}</button></div>
  <nav class="mobile-menu-content" aria-label="Shop categories">
    {% render 'predictive-search-form', context: 'drawer', routes: routes %}
    {% if section.settings.menu != blank %}{% for link in section.settings.menu.links %}<a href="{{ link.url }}">{{ link.title }}</a>{% endfor %}{% else %}
    <a href="{{ routes.root_url }}collections/henleys">Henleys</a>
    <a href="{{ routes.root_url }}collections/t-shirts">T-shirts & mesh</a>
    <a href="{{ routes.root_url }}collections/pants">Pants & denim</a>
    <a href="{{ routes.root_url }}collections/all">The wardrobe</a>{% endif %}
  </nav>
  <a class="eyebrow menu-social" href="{{ settings.instagram_url }}">@zipstersofficial ↗</a>
</dialog>
<dialog id="search-dialog" class="search-dialog" aria-labelledby="search-title"><div class="drawer-top"><span class="eyebrow" id="search-title">Search</span><button class="icon-button" data-close aria-label="Close search">{% render 'icon', name: 'close' %}</button></div>
  {% render 'predictive-search-form', context: 'main', routes: routes %}
  <div class="search-suggestions"><span class="eyebrow">Explore</span><a href="{{ routes.root_url }}collections/henleys">The Henleys</a><a href="{{ routes.root_url }}collections/pants">Pants & denim</a></div>
</dialog>
{% schema %}
{"name":"Header","settings":[{"type":"image_picker","id":"logo","label":"Logo"},{"type":"link_list","id":"menu","label":"Shop menu"}]}
{% endschema %}
