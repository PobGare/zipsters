<section class="social-section get-the-look section-space" id="lookbook"><div class="section-heading"><div><h2>{{ section.settings.heading }}</h2></div><a class="text-link" href="{{ settings.instagram_url }}" target="_blank" rel="noopener">@ZIPSTERSOFFICIAL <span>↗</span></a></div><div class="social-grid">{% for block in section.blocks %}<a href="{{ block.settings.link | default: settings.instagram_url }}" target="_blank" rel="noopener" aria-label="View Zipsters photograph on Instagram" {{ block.shopify_attributes }}>{% render 'image', image: block.settings.image, fallback: block.settings.fallback, alt: block.settings.alt, sizes: '(max-width: 767px) 50vw, 25vw' %}<span class="social-post-cue">{% render 'icon', name: 'instagram' %}<span>VIEW POST ↗</span></span></a>{% endfor %}</div><div class="social-cta"><a class="text-link" href="{{ settings.instagram_url }}" target="_blank" rel="noopener">MORE ON INSTAGRAM <span aria-hidden="true">↗</span></a></div></section>
{% schema %}
{"name":"Instagram editorial","settings":[{"type":"text","id":"heading","label":"Heading","default":"Get the Look"}],"max_blocks":6,"blocks":[{"type":"photo","name":"Instagram photograph","settings":[{"type":"image_picker","id":"image","label":"Photograph"},{"type":"text","id":"fallback","label":"Bundled photo filename"},{"type":"text","id":"alt","label":"Image description"},{"type":"url","id":"link","label":"Instagram post"}]}],"presets":[{"name":"Instagram editorial"}]}
{% endschema %}
