<section class="reels-section campaign-motion" aria-labelledby="motion-title-{{ section.id }}" data-reels>
  <div class="motion-stage">{% for block in section.blocks %}{% assign poster = block.settings.poster | default: block.settings.video.preview_image %}
    <video class="motion-video{% if forloop.first %} is-active{% endif %}" muted playsinline preload="none" disablepictureinpicture disableremoteplayback aria-label="{{ block.settings.alt | escape }}" {% unless forloop.first %}aria-hidden="true"{% endunless %} {% if poster != blank %}poster="{{ poster | image_url: width: 1600 }}"{% else %}poster="{{ block.settings.fallback | append: '-poster.jpg' | asset_url }}"{% endif %} width="1080" height="1920" data-reel-video {{ block.shopify_attributes }}>
      {% if block.settings.video != blank %}{% assign mp4_source = block.settings.video.sources | where: 'mime_type', 'video/mp4' | sort: 'height' | last %}<source data-src="{{ mp4_source.url }}" type="video/mp4">{% else %}
        {% if block.settings.desktop_fallback != blank %}<source data-desktop-src="{{ block.settings.desktop_fallback | append: '.webm' | asset_url }}" type='video/webm; codecs="vp9"'>{% endif %}
        <source data-src="{{ block.settings.fallback | append: '.mp4' | asset_url }}" {% if block.settings.desktop_fallback != blank %}data-desktop-src="{{ block.settings.desktop_fallback | append: '.mp4' | asset_url }}"{% endif %} type="video/mp4">
      {% endif %}
    </video>{% endfor %}
  </div>
  <button class="demo-motion-toggle" data-reel-pause aria-pressed="false">PAUSE FILM</button><div class="motion-copy"><h2 id="motion-title-{{ section.id }}">{{ section.settings.heading | escape }}</h2>{% if section.settings.subheading != blank %}<p>{{ section.settings.subheading | escape }}</p>{% endif %}{% if section.settings.link != blank %}<a class="button button-light" href="{{ section.settings.link }}">{{ section.settings.label | escape }} <span aria-hidden="true">↗</span></a>{% endif %}</div>
</section>
<script src="{{ 'reels.js' | asset_url }}" defer></script>
{% schema %}
{"name":"Zipsters in motion","max_blocks":3,"settings":[{"type":"text","id":"heading","label":"Overlay heading","default":"AFTER HOURS, IN HENLEYS."},{"type":"text","id":"subheading","label":"Supporting line","default":"A sharper take on dressing down."},{"type":"text","id":"label","label":"Button label","default":"SHOP HENLEYS"},{"type":"url","id":"link","label":"Collection link"}],"blocks":[{"type":"reel","name":"Brand reel","settings":[{"type":"video","id":"video","label":"Video"},{"type":"image_picker","id":"poster","label":"Poster frame"},{"type":"text","id":"fallback","label":"Bundled video filename"},{"type":"text","id":"desktop_fallback","label":"Bundled desktop video filename"},{"type":"text","id":"alt","label":"Video description"},{"type":"url","id":"link","label":"Original Instagram reel"}]}],"presets":[{"name":"Zipsters in motion"}]}
{% endschema %}
