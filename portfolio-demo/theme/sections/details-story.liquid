<section class="details-story"><div class="details-copy"><span class="eyebrow">UP CLOSE / THE HENLEY</span><h2>{{ section.settings.heading | newline_to_br }}</h2><p>{{ section.settings.copy }}</p><a class="text-link" href="{{ section.settings.link }}">MEET THE SIGNATURE <span>↗</span></a></div><div class="details-photo">{% render 'image', image: section.settings.image, fallback: 'henley-macro', alt: 'Detailed view of Zipsters Henley buttons, neckline and textured fabric', sizes: '(max-width: 767px) 100vw, 55vw' %}</div></section>
{% schema %}
{"name":"Garment detail story","settings":[{"type":"image_picker","id":"image","label":"Detail photograph"},{"type":"textarea","id":"heading","label":"Heading","default":"It’s all in\nthe details."},{"type":"textarea","id":"copy","label":"Copy","default":"The open neckline. The button placket. The texture you can see. The small things that make a Henley a Henley."},{"type":"url","id":"link","label":"Link","default":"/collections/henleys"}],"presets":[{"name":"Garment detail story"}]}
{% endschema %}
