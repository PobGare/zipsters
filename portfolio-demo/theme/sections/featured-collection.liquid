<section class="merch commerce-merch section-space" id="{{ section.settings.anchor }}">
  <div class="section-heading"><h2>{{ section.settings.heading }}</h2></div>
  <div class="product-grid">
    {% if section.settings.collection != blank %}{% for product in section.settings.collection.products limit: section.settings.limit %}{% render 'product-card', product: product %}{% endfor %}
    {% else %}{% for block in section.blocks %}{% render 'product-card', product: block.settings.product, block: block %}{% endfor %}{% endif %}
  </div>
</section>
{% schema %}
{"name":"Featured collection","settings":[{"type":"text","id":"anchor","label":"Section anchor","default":"best-sellers"},{"type":"text","id":"heading","label":"Heading","default":"Best Sellers"},{"type":"collection","id":"collection","label":"Collection"},{"type":"range","id":"limit","label":"Product count","min":4,"max":12,"step":4,"default":4}],"blocks":[{"type":"piece","name":"Featured piece","settings":[{"type":"product","id":"product","label":"Shopify product"},{"type":"text","id":"title","label":"Verified product name"},{"type":"text","id":"color","label":"Color"},{"type":"url","id":"link","label":"Product link"},{"type":"image_picker","id":"image","label":"Photograph"},{"type":"image_picker","id":"image_alt","label":"Hover photograph"},{"type":"text","id":"fallback","label":"Bundled photo filename"},{"type":"text","id":"fallback_alt","label":"Bundled hover photo filename"}]}],"presets":[{"name":"Featured collection"}]}
{% endschema %}
